{
  "name": "shubh-mangal-plot-explorer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test scripts/*.test.mjs tests/*.test.mjs",
    "predev": "node scripts/prepare_public.mjs",
    "prebuild": "node scripts/prepare_public.mjs",
    "lint": "eslint .",
    "test:e2e": "playwright test",
    "api": "node --env-file-if-exists=.env server/start.mjs",
    "start": "node --env-file-if-exists=.env server/start.mjs",
    "db:migrate": "node --env-file-if-exists=.env scripts/database.mjs migrate",
    "db:seed": "node --env-file-if-exists=.env scripts/database.mjs seed",
    "db:owner": "node --env-file-if-exists=.env scripts/database.mjs owner",
    "db:verify": "node --env-file-if-exists=.env scripts/database.mjs verify",
    "db:backup": "node --env-file-if-exists=.env scripts/database.mjs backup-local",
    "db:restore": "node --env-file-if-exists=.env scripts/database.mjs restore-local",
    "manifest": "node scripts/manifest.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.14",
    "@react-three/fiber": "^9.8.2",
    "compression": "^1.8.2",
    "csv-parse": "^7.0.3",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "pg": "^8.23.1",
    "polygon-clipping": "0.15.7",
    "proj4": "^2.22.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.187.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "eslint": "^10.14.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "vite": "^7.0.0"
  },
  "engines": {
    "node": ">=24.16.0"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
