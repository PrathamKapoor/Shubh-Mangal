# Node 24.16+. Copy to .env. Never prefix server secrets with VITE_.
NODE_ENV=development
APP_ORIGIN=http://127.0.0.1:5173
API_HOST=127.0.0.1
API_PORT=3001
DEMO_MODE=true
# Empty DATABASE_URL selects the explicit local PGlite database. Production requires PostgreSQL.
DATABASE_URL=
LOCAL_DB_PATH=.local/database
# Private staged images; use an absolute, persistent path in production.
MEDIA_DIRECTORY=.local/media
PG_SSL=false
# Provision privately with npm run db:owner, then remove OWNER_PASSWORD from .env.
OWNER_EMAIL=
OWNER_NAME=
OWNER_PASSWORD=
# Optional Vite proxy target; normally no change needed.
API_PROXY_TARGET=http://127.0.0.1:3001
# Production behind exactly one trusted local reverse proxy: set to 1. Never trust all proxies.
TRUST_PROXY_HOPS=0
# Optional browser-visible restricted Maps JavaScript API key; rebuild after changes.
VITE_GOOGLE_MAPS_ENABLED=false
VITE_GOOGLE_MAPS_KEY=
# Production CSP allowlist must match the build switch. No server credential needed.
GOOGLE_MAPS_ENABLED=false
# Optional public display name only; visual assets, source geometry and seed remain site-specific.
# SITE_NAME=Example Development
# Optional source bundle for isolated database initialization tests only. Alternate
# site startup is disabled until browser layout and assets are configurable.
# SITE_SOURCE_CONFIG=tests/fixtures/second-site/source.json
